  "items": [
    {
      "id": "rule:alloc-human-baseline",
      "kind": "rule",
      "content": {
        "id": "alloc-human-baseline",
        "description": "Allows candidate human_specialist for every support request. There are no state conditions. Priority 10, score 1. The baseline score is lower than the conditional support_agent preference.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "human_specialist"
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 1.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "A human specialist may handle every support request.",
            "start": 129,
            "end": 181,
            "locator": "line:7;section:## Work allocation"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
      "id": "rule:alloc-agent-preferred",
      "kind": "rule",
      "content": {
        "id": "alloc-agent-preferred",
        "description": "Allows and prefers candidate support_agent when all of these hold: state.urgent is false, state.sensitivity is 'standard', and state.agent_available is true. Priority 10, score 2. This score is higher than human_specialist, so support_agent wins in this state.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "support_agent"
            },
            {
              "path": "state.urgent",
              "op": "eq",
              "value": false
            },
            {
              "path": "state.sensitivity",
              "op": "eq",
              "value": "standard"
            },
            {
              "path": "state.agent_available",
              "op": "eq",
              "value": true
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 2.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Prefer the support agent for non-urgent, standard-sensitivity requests when the agent is available.",
            "start": 182,
            "end": 281,
            "locator": "line:8;section:## Work allocation"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
      "id": "rule:alloc-agent-deny-urgent-restricted-unavailable",
      "kind": "rule",
      "content": {
        "id": "alloc-agent-deny-urgent-restricted-unavailable",
        "description": "Denies candidate support_agent when any of these hold: state.urgent is true, state.sensitivity is 'restricted', or state.agent_available is false. Priority 20, which overrides the priority-10 agent preference. In these states the human_specialist is used.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "support_agent"
            }
          ],
          "any_of": [
            {
              "path": "state.urgent",
              "op": "eq",
              "value": true
            },
            {
              "path": "state.sensitivity",
              "op": "eq",
              "value": "restricted"
            },
            {
              "path": "state.agent_available",
              "op": "eq",
              "value": false
            }
          ]
        },
        "effect": "deny",
        "priority": 20,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Use the human specialist for urgent or restricted requests and whenever the support agent is unavailable.",
            "start": 282,
            "end": 387,
            "locator": "line:9;section:## Work allocation"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
      "id": "rule:share-full-internal",
      "kind": "rule",
      "content": {
        "id": "share-full-internal",
        "description": "Allows candidate share_full_record when state.recipient_type is 'internal_project_member'. Priority 10, score 3 (the most informative disclosure).",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "share_full_record"
            },
            {
              "path": "state.recipient_type",
              "op": "eq",
              "value": "internal_project_member"
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 3.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Internal project members may receive the full customer record.",
            "start": 413,
            "end": 475,
            "locator": "line:13;section:## Information sharing"
          },
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
