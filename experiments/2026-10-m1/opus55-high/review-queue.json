        "question": "What customer record disclosure, if any, should be made to this recipient?",
        "candidates": [
          {
            "id": "share_full_record",
            "description": "Share the full customer record.",
            "attributes": {
              "informativeness": 3
            }
          },
          {
            "id": "share_redacted_summary",
            "description": "Share a redacted summary of the customer record.",
