    {
      "id": "rule:refund-execute-small",
      "kind": "rule",
      "content": {
        "id": "refund-execute-small",
        "description": "Allows candidate execute_refund immediately when state.amount is at most 1000 (inclusive). A null amount does not match. Priority 10, score 3.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "execute_refund"
            },
            {
              "path": "state.amount",
              "op": "lte",
              "value": 1000
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 3.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Refunds up to and including 1000 units may be executed immediately.",
            "start": 757,
            "end": 824,
            "locator": "line:20;section:## Action selection"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
