    {
      "id": "node:route_support_request",
      "kind": "node",
      "content": {
        "id": "route_support_request",
        "kind": "allocate_work",
        "question": "Who should handle this support request: the support agent or a human specialist?",
        "candidates": [
          {
            "id": "support_agent",
            "description": "Route the request to the support agent.",
            "attributes": {
              "handler_type": "agent"
            }
          },
          {
            "id": "human_specialist",
            "description": "Route the request to a human specialist.",
            "attributes": {
              "handler_type": "human"
            }
          }
        ],
        "rule_ids": [
          "alloc-human-baseline",
          "alloc-agent-preferred",
          "alloc-agent-deny-urgent-restricted-unavailable"
        ],
        "dimensions": [
          {
            "path": "state.urgent",
            "values": [
              true,
              false
            ]
          },
          {
            "path": "state.sensitivity",
            "values": [
              "standard",
              "restricted"
            ]
          },
          {
            "path": "state.agent_available",
            "values": [
              true,
              false
            ]
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
