    {
      "id": "rule:outcome_accept",
      "kind": "rule",
      "content": {
        "id": "outcome_accept",
        "description": "At priority 10, allow candidate accept_delivery with score 0 only when acceptance_checks_status is passed and evidence_status is complete. Incomplete, failed, missing, or null checks do not satisfy this permission, nor does incomplete, missing, or null evidence.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "accept_delivery"
            },
            {
              "path": "state.acceptance_checks_status",
              "op": "eq",
