  "items": [
    {
      "id": "rule:allocation_human_allowed",
      "kind": "rule",
      "content": {
        "id": "allocation_human_allowed",
        "description": "At priority 10, allow candidate human_specialist for every support request with score 0. The human specialist remains permitted even when the support agent is preferred.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "human_specialist"
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "A human specialist may handle every support request.",
            "start": 129,
            "end": 181,
            "locator": "line:7;section:## Work allocation"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
      "id": "rule:allocation_agent_preferred",
      "kind": "rule",
      "content": {
        "id": "allocation_agent_preferred",
        "description": "At priority 10, allow candidate support_agent with score 10 when urgent is false, sensitivity is standard, and agent_available is true. This score prefers support_agent over the permitted human_specialist in exactly these states.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "support_agent"
            },
            {
              "path": "state.urgent",
              "op": "eq",
              "value": false
            },
            {
              "path": "state.sensitivity",
              "op": "eq",
              "value": "standard"
            },
            {
              "path": "state.agent_available",
              "op": "eq",
              "value": true
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 10.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Prefer the support agent for non-urgent, standard-sensitivity requests when the agent is available.",
            "start": 182,
            "end": 281,
            "locator": "line:8;section:## Work allocation"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
      "id": "rule:allocation_agent_prohibited",
      "kind": "rule",
      "content": {
        "id": "allocation_agent_prohibited",
        "description": "At priority 20, deny candidate support_agent when urgent is true, sensitivity is restricted, or agent_available is false. This denial overrides its priority-10 permission; human_specialist remains explicitly permitted by allocation_human_allowed.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "support_agent"
            }
          ],
          "any_of": [
            {
              "path": "state.urgent",
              "op": "eq",
              "value": true
            },
            {
              "path": "state.sensitivity",
              "op": "eq",
              "value": "restricted"
            },
            {
              "path": "state.agent_available",
              "op": "eq",
              "value": false
            }
          ]
        },
        "effect": "deny",
        "priority": 20,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Use the human specialist for urgent or restricted requests and whenever the support agent is unavailable.",
            "start": 282,
            "end": 387,
            "locator": "line:9;section:## Work allocation"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
      "id": "rule:sharing_full_internal",
      "kind": "rule",
      "content": {
        "id": "sharing_full_internal",
        "description": "At priority 10, allow candidate full_record with score 20 when recipient_type is internal_project_member. The score ranks a permitted full record above a permitted redacted summary, which has score 10.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "full_record"
            },
            {
              "path": "state.recipient_type",
              "op": "eq",
              "value": "internal_project_member"
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 20.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Internal project members may receive the full customer record.",
            "start": 413,
            "end": 475,
            "locator": "line:13;section:## Information sharing"
          },
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
      "id": "rule:sharing_full_external_approved",
      "kind": "rule",
      "content": {
        "id": "sharing_full_external_approved",
        "description": "At priority 10, allow candidate full_record with score 20 when recipient_type is authorized_external_partner or unauthorized_external_partner and full_record_approval is true. Authorization for a redacted summary is distinct from explicit full-record approval. Score 20 prefers the full record over a permitted summary.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "full_record"
            },
            {
              "path": "state.recipient_type",
              "op": "in",
              "value": [
                "authorized_external_partner",
                "unauthorized_external_partner"
              ]
            },
            {
              "path": "state.full_record_approval",
              "op": "eq",
              "value": true
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 20.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "External partners may receive the full customer record only with explicit full-record approval.",
            "start": 476,
            "end": 571,
            "locator": "line:14;section:## Information sharing"
          },
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
    {
      "id": "rule:sharing_full_external_unapproved_denied",
      "kind": "rule",
      "content": {
        "id": "sharing_full_external_unapproved_denied",
        "description": "At priority 20, deny candidate full_record for either external-partner recipient type when full_record_approval is false, explicitly null, or absent. This overrides any priority-10 permission and does not itself permit a summary or rejection.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "full_record"
            },
            {
              "path": "state.recipient_type",
              "op": "in",
              "value": [
                "authorized_external_partner",
                "unauthorized_external_partner"
              ]
            }
          ],
          "any_of": [
            {
              "path": "state.full_record_approval",
              "op": "eq",
              "value": false
            },
            {
              "path": "state.full_record_approval",
              "op": "eq",
              "value": null
            },
            {
              "path": "state.full_record_approval",
              "op": "exists",
              "value": false
            }
          ]
        },
        "effect": "deny",
        "priority": 20,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "External partners may receive the full customer record only with explicit full-record approval.",
            "start": 476,
            "end": 571,
            "locator": "line:14;section:## Information sharing"
          }
        ]
      },
      "status": "pending",
      "review": null
    },
