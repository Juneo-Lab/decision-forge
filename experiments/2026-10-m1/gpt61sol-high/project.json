        "description": "At priority 100, explicitly allow candidate request_amount with score 0 when amount is present and explicitly null, representing no supplied amount, regardless of approval. This is separate from the absent-key clarification rule.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "request_amount"
