            },
            {
              "path": "state.refund_approved",
              "op": "eq",
              "value": null
            },
            {
              "path": "state.refund_approved",
              "op": "exists",
              "value": false
            }
          ]
        },
        "effect": "allow",
        "priority": 10,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Refunds above 1000 units require approval before execution.",
            "start": 825,
            "end": 884,
            "locator": "line:21;section:## Action selection"
          }
        ]
      },
      {
        "id": "refund_execute_missing_amount_denied",
