{
  "schema_version": "1.0",
  "organization": {
    "id": "northstar_support",
    "name": "Northstar Support (fictional)",
    "policy_version": "2026-10-demo (draft for business review)",
    "rules": [
      {
        "id": "allocation_human_allowed",
        "description": "At priority 10, allow candidate human_specialist for every support request with score 0. The human specialist remains permitted even when the support agent is preferred.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "human_specialist"
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "A human specialist may handle every support request.",
            "start": 129,
            "end": 181,
            "locator": "line:7;section:## Work allocation"
          }
        ]
      },
      {
        "id": "allocation_agent_preferred",
        "description": "At priority 10, allow candidate support_agent with score 10 when urgent is false, sensitivity is standard, and agent_available is true. This score prefers support_agent over the permitted human_specialist in exactly these states.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "support_agent"
            },
            {
              "path": "state.urgent",
              "op": "eq",
              "value": false
            },
            {
              "path": "state.sensitivity",
              "op": "eq",
              "value": "standard"
            },
            {
              "path": "state.agent_available",
              "op": "eq",
              "value": true
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 10.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Prefer the support agent for non-urgent, standard-sensitivity requests when the agent is available.",
            "start": 182,
            "end": 281,
            "locator": "line:8;section:## Work allocation"
          }
        ]
      },
      {
        "id": "allocation_agent_prohibited",
        "description": "At priority 20, deny candidate support_agent when urgent is true, sensitivity is restricted, or agent_available is false. This denial overrides its priority-10 permission; human_specialist remains explicitly permitted by allocation_human_allowed.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "support_agent"
            }
          ],
          "any_of": [
            {
              "path": "state.urgent",
              "op": "eq",
              "value": true
            },
            {
              "path": "state.sensitivity",
              "op": "eq",
              "value": "restricted"
            },
            {
              "path": "state.agent_available",
              "op": "eq",
              "value": false
            }
          ]
        },
        "effect": "deny",
        "priority": 20,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Use the human specialist for urgent or restricted requests and whenever the support agent is unavailable.",
            "start": 282,
            "end": 387,
            "locator": "line:9;section:## Work allocation"
          }
        ]
      },
      {
        "id": "sharing_full_internal",
        "description": "At priority 10, allow candidate full_record with score 20 when recipient_type is internal_project_member. The score ranks a permitted full record above a permitted redacted summary, which has score 10.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "full_record"
            },
            {
              "path": "state.recipient_type",
              "op": "eq",
              "value": "internal_project_member"
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 20.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Internal project members may receive the full customer record.",
            "start": 413,
            "end": 475,
            "locator": "line:13;section:## Information sharing"
          },
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      {
        "id": "sharing_full_external_approved",
        "description": "At priority 10, allow candidate full_record with score 20 when recipient_type is authorized_external_partner or unauthorized_external_partner and full_record_approval is true. Authorization for a redacted summary is distinct from explicit full-record approval. Score 20 prefers the full record over a permitted summary.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "full_record"
            },
            {
              "path": "state.recipient_type",
              "op": "in",
              "value": [
                "authorized_external_partner",
                "unauthorized_external_partner"
              ]
            },
            {
              "path": "state.full_record_approval",
              "op": "eq",
              "value": true
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 20.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "External partners may receive the full customer record only with explicit full-record approval.",
            "start": 476,
            "end": 571,
            "locator": "line:14;section:## Information sharing"
          },
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      {
        "id": "sharing_full_external_unapproved_denied",
        "description": "At priority 20, deny candidate full_record for either external-partner recipient type when full_record_approval is false, explicitly null, or absent. This overrides any priority-10 permission and does not itself permit a summary or rejection.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "full_record"
            },
            {
              "path": "state.recipient_type",
              "op": "in",
              "value": [
                "authorized_external_partner",
                "unauthorized_external_partner"
              ]
            }
          ],
          "any_of": [
            {
              "path": "state.full_record_approval",
              "op": "eq",
              "value": false
            },
            {
              "path": "state.full_record_approval",
              "op": "eq",
              "value": null
            },
            {
              "path": "state.full_record_approval",
              "op": "exists",
              "value": false
            }
          ]
        },
        "effect": "deny",
        "priority": 20,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "External partners may receive the full customer record only with explicit full-record approval.",
            "start": 476,
            "end": 571,
            "locator": "line:14;section:## Information sharing"
          }
        ]
      },
      {
        "id": "sharing_summary_authorized_external",
        "description": "At priority 10, allow candidate redacted_summary with score 10 when recipient_type is authorized_external_partner. Full-record approval is not required for this summary. Its score is below the score of a permitted full_record.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "redacted_summary"
            },
            {
              "path": "state.recipient_type",
              "op": "eq",
              "value": "authorized_external_partner"
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 10.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Authorized external partners may receive a redacted summary.",
            "start": 572,
            "end": 632,
            "locator": "line:15;section:## Information sharing"
          },
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      {
        "id": "sharing_reject_unauthorized_external",
        "description": "At priority 10, allow candidate reject_disclosure with score 0 when recipient_type is unauthorized_external_partner and full_record_approval is false, explicitly null, or absent. Neither disclosure candidate is permitted in these states.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "reject_disclosure"
            },
            {
              "path": "state.recipient_type",
              "op": "eq",
              "value": "unauthorized_external_partner"
            }
          ],
          "any_of": [
            {
              "path": "state.full_record_approval",
              "op": "eq",
              "value": false
            },
            {
              "path": "state.full_record_approval",
              "op": "eq",
              "value": null
            },
            {
              "path": "state.full_record_approval",
              "op": "exists",
              "value": false
            }
          ]
        },
        "effect": "allow",
        "priority": 10,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "External partners may receive the full customer record only with explicit full-record approval.",
            "start": 476,
            "end": 571,
            "locator": "line:14;section:## Information sharing"
          },
          {
            "source_id": "handbook",
            "quote": "Authorized external partners may receive a redacted summary.",
            "start": 572,
            "end": 632,
            "locator": "line:15;section:## Information sharing"
          },
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      {
        "id": "sharing_reject_unrecognized_recipient",
        "description": "At priority 10, allow candidate reject_disclosure with score 0 when recipient_type is present but is none of internal_project_member, authorized_external_partner, or unauthorized_external_partner. This includes an explicitly null recipient type; neither disclosure has a matching permission.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "reject_disclosure"
            },
            {
              "path": "state.recipient_type",
              "op": "exists",
              "value": true
            },
            {
              "path": "state.recipient_type",
              "op": "ne",
              "value": "internal_project_member"
            },
            {
              "path": "state.recipient_type",
              "op": "ne",
              "value": "authorized_external_partner"
            },
            {
              "path": "state.recipient_type",
              "op": "ne",
              "value": "unauthorized_external_partner"
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      {
        "id": "sharing_reject_missing_recipient",
        "description": "At priority 10, allow candidate reject_disclosure with score 0 when the recipient_type key is absent. No recipient-based disclosure permission matches in this state. This rule distinguishes an absent key from an explicitly null value.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "reject_disclosure"
            },
            {
              "path": "state.recipient_type",
              "op": "exists",
              "value": false
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Prefer the most informative permitted disclosure; reject the request when no disclosure is permitted.",
            "start": 633,
            "end": 734,
            "locator": "line:16;section:## Information sharing"
          }
        ]
      },
      {
        "id": "refund_execute_small",
        "description": "At priority 10, allow candidate execute_refund with score 0 when amount is at most 1000, including exactly 1000. Approval is not required in these states. Numeric comparisons do not match an absent or null amount.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "execute_refund"
            },
            {
              "path": "state.amount",
              "op": "lte",
              "value": 1000
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 10,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Refunds up to and including 1000 units may be executed immediately.",
            "start": 757,
            "end": 824,
            "locator": "line:20;section:## Action selection"
          }
        ]
      },
      {
        "id": "refund_execute_approved",
        "description": "At priority 20, allow candidate execute_refund with score 0 when refund_approved is true and amount is present and non-null. No amount threshold applies to an approved refund. The priority-100 missing-amount and null-amount denials preserve the requirement to obtain an amount before execution.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "execute_refund"
            },
            {
              "path": "state.refund_approved",
              "op": "eq",
              "value": true
            },
            {
              "path": "state.amount",
              "op": "exists",
              "value": true
            },
            {
              "path": "state.amount",
              "op": "ne",
              "value": null
            }
          ],
          "any_of": []
        },
        "effect": "allow",
        "priority": 20,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "An approved refund may be executed regardless of amount.",
            "start": 885,
            "end": 941,
            "locator": "line:22;section:## Action selection"
          },
          {
            "source_id": "handbook",
            "quote": "Request the missing amount before deciding whether to execute a refund.",
            "start": 942,
            "end": 1013,
            "locator": "line:23;section:## Action selection"
          }
        ]
      },
      {
        "id": "refund_execute_large_unapproved_denied",
        "description": "At priority 30, deny candidate execute_refund when amount exceeds 1000 and refund_approved is false, explicitly null, or absent. This overrides lower-priority execution permissions but does not itself permit requesting approval.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "execute_refund"
            },
            {
              "path": "state.amount",
              "op": "gt",
              "value": 1000
            }
          ],
          "any_of": [
            {
              "path": "state.refund_approved",
              "op": "eq",
              "value": false
            },
            {
              "path": "state.refund_approved",
              "op": "eq",
              "value": null
            },
            {
              "path": "state.refund_approved",
              "op": "exists",
              "value": false
            }
          ]
        },
        "effect": "deny",
        "priority": 30,
        "score": 0.0,
        "evidence": [
          {
            "source_id": "handbook",
            "quote": "Refunds above 1000 units require approval before execution.",
            "start": 825,
            "end": 884,
            "locator": "line:21;section:## Action selection"
          }
        ]
      },
      {
        "id": "refund_request_approval",
        "description": "At priority 10, explicitly allow candidate request_approval with score 0 when amount exceeds 1000 and refund_approved is false, explicitly null, or absent. Request approval rather than execute the unapproved refund.",
        "when": {
          "all_of": [
            {
              "path": "candidate.id",
              "op": "eq",
              "value": "request_approval"
            },
            {
              "path": "state.amount",
              "op": "gt",
              "value": 1000
            }
          ],
          "any_of": [
            {
              "path": "state.refund_approved",
              "op": "eq",
